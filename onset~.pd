#N canvas 200 100 720 540 12;
#X obj 40 40 inlet~ (signal) audio to watch for hits;
#X obj 40 100 abs~;
#X obj 40 150 lop~ 20;
#X obj 40 200 snapshot~;
#X obj 40 255 > 0.05;
#X obj 40 300 change;
#X obj 40 345 sel 1;
#X obj 40 400 outlet (bang) fires once when the level crosses the threshold;
#X obj 380 40 loadbang;
#X obj 380 80 t b b;
#X msg 380 200 1;
#X obj 380 245 metro 2;
#X obj 490 120 f \$1;
#X obj 490 160 sel 0;
#X text 40 440 onset~ - bangs on a transient. argument is the threshold \, default 0.05;
#X text 40 475 abs~ and lop~ make a rough envelope \; change means it fires once per crossing rather than continuously \, and will not fire again until the level drops back below the threshold;
#X text 490 200 a threshold of 0 (no argument) leaves the default alone;
#X text 480 510 AC ARHA/MUSI 274;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 8 0 9 0;
#X connect 9 1 12 0;
#X connect 9 0 10 0;
#X connect 10 0 11 0;
#X connect 11 0 3 0;
#X connect 12 0 13 0;
#X connect 13 1 4 1;
