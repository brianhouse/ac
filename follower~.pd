#N canvas 200 100 700 470 12;
#X obj 40 40 inlet~ (signal) audio to follow;
#X obj 40 110 *~;
#X obj 40 170 lop~ 10;
#X obj 40 230 sqrt~;
#X obj 40 300 outlet~ (signal) RMS amplitude \, 0 to 1;
#X obj 320 40 loadbang;
#X obj 320 85 f \$1;
#X obj 320 130 sel 0;
#X text 40 345 follower~ - RMS envelope follower. argument is the smoothing cutoff in Hz \, default 10;
#X text 40 380 square the signal \, average it with a lowpass \, take the square root. lower cutoff = smoother and slower;
#X text 40 415 output is linear amplitude \, not dB - multiply it into a signal directly \, or use ac/dbpeak~ if you want decibels;
#X text 320 175 a cutoff of 0 (no argument) leaves the default alone;
#X text 460 440 AC ARHA/MUSI 274;
#X connect 0 0 1 0;
#X connect 0 0 1 1;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 1 2 1;
