#N canvas 827 239 760 560 12;
#X obj 40 40 inlet~ (signal/float) audio input;
#X obj 40 200 hip~;
#X obj 40 250 hip~;
#X obj 40 320 outlet~ (signal) high-pass filtered audio;
#X text 540 520 AC ARHA/MUSI 274;
#X obj 260 40 inlet~ (signal/float) rolloff frequency in Hz (0 to 20000);
#X obj 260 90 clip~ 0 20000;
#X obj 260 140 ac/unsig~ 10;
#X obj 260 190 * 0.6436;
#X text 260 240 two 1-pole stages in series = 12 dB/octave. together they reach -6 dB the -3 dB point lands 1.554x too high \, so the frequency is scaled back by 0.6436 to compensate.;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 1 1;
#X connect 8 0 2 1;
