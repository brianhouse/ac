#N canvas 200 100 700 520 12;
#X obj 40 40 inlet~ (signal) audio to measure;
#X obj 40 100 abs~;
#X obj 40 150 max~;
#X obj 200 100 r~ \$0-pk;
#X obj 200 150 *~ 0.995;
#X obj 40 260 s~ \$0-pk;
#X obj 40 205 snapshot~;
#X obj 40 310 rmstodb;
#X obj 40 355 - 100;
#X obj 40 410 outlet (float) peak level in dBFS - 0 is full scale;
#X obj 400 40 loadbang;
#X obj 400 80 t b b;
#X msg 400 200 1;
#X obj 400 245 metro 50;
#X obj 500 120 f \$1;
#X obj 500 160 sel 0;
#X text 40 450 dbpeak~ - peak level with decay. argument is the poll interval in ms \, default 50;
#X text 200 190 the s~/r~ pair feeds the previous peak back \, scaled down a little each block \, so the reading falls away instead of sticking;
#X text 500 200 a poll interval of 0 (no argument) leaves the default alone;
#X text 460 480 AC ARHA/MUSI 274;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 5 0;
#X connect 2 0 6 0;
#X connect 3 0 4 0;
#X connect 4 0 2 1;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 10 0 11 0;
#X connect 11 1 14 0;
#X connect 11 0 12 0;
#X connect 12 0 13 0;
#X connect 13 0 6 0;
#X connect 14 0 15 0;
#X connect 15 1 13 1;
