#N canvas 827 239 734 565 12;
#N canvas 0 0 450 250 (subpatch) 0;
#X array my_array 100 float 2;
#X coords 0 1 100 -1 300 100 1;
#X restore 100 92 graph;
#X text 100 50 1) an array with audio in it;
#X msg 100 230 read pixies.wav;
#X obj 100 270 ac/smpload my_array;
#X obj 100 340 bng 25 250 50 0 empty empty empty 0 -10 0 10 #191919 #e1e1e1 #e1e1e1;
#X msg 330 340 write my_copy.wav;
#X obj 100 420 ac/smpsave my_array;
#X text 100 460 saves a 24-bit wav at the current sample rate;
#X text 509 494 BH for AC ARHA/MUSI 274;
#X text 260 230 2) load something to save;
#X text 135 343 3a) bang opens a save dialog;
#X text 330 370 3b) ...or send a filename to save next to this patch;
#X connect 2 0 3 0;
#X connect 4 0 6 0;
#X connect 5 0 6 0;
